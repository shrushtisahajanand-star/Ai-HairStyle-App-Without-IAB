<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shimmerItem"
    android:layout_width="@dimen/_84sdp"
    android:layout_height="wrap_content"
    android:paddingEnd="@dimen/_8sdp"
    app:shimmer_auto_start="true"
    app:shimmer_base_alpha="0.55"
    app:shimmer_duration="1100"
    app:shimmer_highlight_alpha="1"
    app:shimmer_intensity="0.3">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/_8sdp">

        <View
            android:layout_width="@dimen/_46sdp"
            android:layout_height="@dimen/_46sdp"
            android:background="@drawable/bg_shimmer_circle" />

        <View
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:background="@drawable/bg_shimmer_placeholder" />
    </LinearLayout>

</com.facebook.shimmer.ShimmerFrameLayout>
