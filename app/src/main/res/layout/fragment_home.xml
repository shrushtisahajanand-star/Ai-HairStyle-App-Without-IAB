<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/background"
    android:fillViewport="false">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/heroContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/heroViewPager"
                android:layout_width="0dp"
                android:layout_height="@dimen/_260sdp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/heroOverlay"
                android:layout_width="0dp"
                android:layout_height="@dimen/_260sdp"
                android:adjustViewBounds="true"
                android:background="@drawable/ic_hero_vector"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="@id/heroViewPager"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tvHeroTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_14sdp"
                android:layout_marginEnd="@dimen/_10sdp"
                android:layout_marginBottom="@dimen/_12sdp"
                android:ellipsize="end"
                android:fontFamily="@font/saans_semibold"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:textColor="@color/white"
                android:textSize="@dimen/_16ssp"
                app:layout_constraintBottom_toTopOf="@id/heroDotsIndicator"
                app:layout_constraintEnd_toStartOf="@id/btnHeroTryIt"
                app:layout_constraintStart_toStartOf="parent"
                tools:text="Curtain Bangs Hairstyle" />

            <com.hairstyle.generator.aimakerover.ui.home.HeroGradientDotsIndicator
                android:id="@+id/heroDotsIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_14sdp"
                android:layout_marginBottom="@dimen/_28sdp"
                app:layout_constraintBottom_toBottomOf="@id/heroViewPager"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/btnHeroTryIt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/_14sdp"
                android:background="@drawable/ic_try_it"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/saans_semibold"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:includeFontPadding="false"
                android:paddingHorizontal="@dimen/_20sdp"
                android:paddingVertical="@dimen/_8sdp"
                android:text="@string/try_it"
                android:textColor="@color/black"
                android:textSize="@dimen/_12ssp"
                app:layout_constraintTop_toTopOf="@+id/tvHeroTitle"
                app:layout_constraintBottom_toBottomOf="@id/heroDotsIndicator"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:id="@+id/homeCategoryVideos"
            android:layout_width="0dp"
            android:layout_height="@dimen/_130sdp"
            android:layout_marginTop="@dimen/_minus15sdp"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:weightSum="3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/heroContainer">

            <include
                android:id="@+id/categoryVideoBeard"
                layout="@layout/item_home_category_video"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/_6sdp"
                android:layout_weight="1" />

            <include
                android:id="@+id/categoryVideoHairstyle"
                layout="@layout/item_home_category_video"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="@dimen/_3sdp"
                android:layout_weight="1" />

            <include
                android:id="@+id/categoryVideoFun"
                layout="@layout/item_home_category_video"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/_6sdp"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnUploadPhoto"
            android:layout_width="0dp"
            android:layout_height="@dimen/_36sdp"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_12sdp"
            android:background="@drawable/bg_upload_photo_button"
            android:clickable="true"
            android:elevation="6dp"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/homeCategoryVideos">

            <ImageView
                android:layout_width="@dimen/_16sdp"
                android:layout_height="@dimen/_16sdp"
                android:contentDescription="@null"
                android:src="@drawable/ic_camara" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_8sdp"
                android:fontFamily="@font/saans_medium"
                android:includeFontPadding="false"
                android:text="@string/upload_your_photo"
                android:textColor="@color/white"
                android:textSize="@dimen/_13sdp" />
        </LinearLayout>


        <LinearLayout
            android:id="@+id/menHairstyleHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_20sdp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnUploadPhoto">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/saans_semibold"
                android:includeFontPadding="false"
                android:text="@string/men_hairstyles"
                android:textColor="@color/white"
                android:textSize="@dimen/_14ssp" />

            <TextView
                android:id="@+id/btnSeeAllMen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_create"
                android:backgroundTint="@color/view_color"
                android:fontFamily="@font/saans_medium"
                android:includeFontPadding="false"
                android:paddingHorizontal="@dimen/_12sdp"
                android:paddingVertical="@dimen/_6sdp"
                android:text="@string/see_all"
                android:textColor="@color/white"
                android:textSize="@dimen/_11ssp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/menHairstyleListContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/menHairstyleHeader">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMenHairstyles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:orientation="horizontal"
                android:overScrollMode="never"
                android:paddingHorizontal="@dimen/_10sdp"
                android:visibility="gone"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmerMenHairstyles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="visible"
                app:shimmer_auto_start="true"
                app:shimmer_base_alpha="0.55"
                app:shimmer_duration="1100"
                app:shimmer_highlight_alpha="1"
                app:shimmer_intensity="0.3">

                <include layout="@layout/layout_shimmer_home_row" />
            </com.facebook.shimmer.ShimmerFrameLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/womenHairstyleHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_20sdp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/menHairstyleListContainer">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/saans_semibold"
                android:includeFontPadding="false"
                android:text="@string/women_hairstyles"
                android:textColor="@color/white"
                android:textSize="@dimen/_14ssp" />

            <TextView
                android:id="@+id/btnSeeAllWomen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_create"
                android:backgroundTint="@color/view_color"
                android:fontFamily="@font/saans_medium"
                android:includeFontPadding="false"
                android:paddingHorizontal="@dimen/_12sdp"
                android:paddingVertical="@dimen/_6sdp"
                android:text="@string/see_all"
                android:textColor="@color/white"
                android:textSize="@dimen/_11ssp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/womenHairstyleListContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/womenHairstyleHeader">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvWomenHairstyles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:orientation="horizontal"
                android:overScrollMode="never"
                android:paddingHorizontal="@dimen/_10sdp"
                android:visibility="gone"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmerWomenHairstyles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="visible"
                app:shimmer_auto_start="true"
                app:shimmer_base_alpha="0.55"
                app:shimmer_duration="1100"
                app:shimmer_highlight_alpha="1"
                app:shimmer_intensity="0.3">

                <include layout="@layout/layout_shimmer_home_row" />
            </com.facebook.shimmer.ShimmerFrameLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/childrenHairstyleHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_20sdp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/womenHairstyleListContainer">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/saans_semibold"
                android:includeFontPadding="false"
                android:text="@string/children_hairstyles"
                android:textColor="@color/white"
                android:textSize="@dimen/_14ssp" />

            <TextView
                android:id="@+id/btnSeeAllChildren"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_create"
                android:backgroundTint="@color/view_color"
                android:fontFamily="@font/saans_medium"
                android:includeFontPadding="false"
                android:paddingHorizontal="@dimen/_12sdp"
                android:paddingVertical="@dimen/_6sdp"
                android:text="@string/see_all"
                android:textColor="@color/white"
                android:textSize="@dimen/_11ssp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/childrenHairstyleListContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:paddingBottom="@dimen/_20sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/childrenHairstyleHeader">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvChildrenHairstyles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:orientation="horizontal"
                android:overScrollMode="never"
                android:paddingHorizontal="@dimen/_10sdp"
                android:visibility="gone"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmerChildrenHairstyles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="visible"
                app:shimmer_auto_start="true"
                app:shimmer_base_alpha="0.55"
                app:shimmer_duration="1100"
                app:shimmer_highlight_alpha="1"
                app:shimmer_intensity="0.3">

                <include layout="@layout/layout_shimmer_home_row" />
            </com.facebook.shimmer.ShimmerFrameLayout>
        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>

