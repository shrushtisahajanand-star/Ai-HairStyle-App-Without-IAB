<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/orig_background"
    android:keepScreenOn="true"
    tools:context="com.hairstyle.changer.aitryon.ui.intro.Intro1Fragment">

    <ImageView
        android:id="@+id/ivVideoPlaceholder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/_110sdp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:visibility="gone"
        tools:src="@drawable/ic_intro2_image_1" />

    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmerIntroVideo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:shimmer_auto_start="true"
        app:shimmer_base_alpha="1"
        app:shimmer_base_color="@color/orig_shimmer_base"
        app:shimmer_duration="1100"
        app:shimmer_highlight_alpha="0.6"
        app:shimmer_highlight_color="@color/shimmer_highlight"
        app:shimmer_intensity="0.4">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_shimmer_placeholder_orig" />

    </com.facebook.shimmer.ShimmerFrameLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never" />

    <ImageView
        android:id="@+id/ivSplashVector"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="fitXY"
        android:src="@drawable/ic_splash_vector" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/bottomSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_20sdp"
            android:paddingTop="@dimen/_16sdp"
            android:paddingBottom="@dimen/_14sdp">

            <com.hairstyle.changer.aitryon.ui.intro.IntroDotsIndicator
                android:id="@+id/dotsIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:clipChildren="false"
                android:clipToPadding="false" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_16sdp"
                android:ellipsize="end"
                android:fontFamily="@font/saans_semibold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="@dimen/_22ssp"
                tools:text="AI Girls Hairstyle" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_38sdp"
                android:layout_marginTop="@dimen/_5sdp"
                android:ellipsize="end"
                android:fontFamily="@font/saans_regular"
                android:gravity="center"
                android:includeFontPadding="false"
                android:lineSpacingExtra="@dimen/_3sdp"
                android:maxLines="2"
                android:minLines="2"
                android:textAlignment="center"
                android:textColor="@color/orig_nav_inactive"
                android:textSize="@dimen/_11ssp"
                tools:text="Discover trendy hairstyles tailored to your look. Find your perfect hairstyle with AI" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnContinue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_36sdp"
                android:fontFamily="@font/saans_medium"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="@dimen/_48sdp"
                android:text="@string/get_started"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:textSize="@dimen/_13ssp"
                app:backgroundTint="@color/white"
                app:cornerRadius="@dimen/_14sdp"
                app:icon="@drawable/ic_arrow_right"
                app:iconGravity="end"
                app:iconTint="@color/textColor" />

        </LinearLayout>

        <!-- Only addition: bottom ads -->
        <FrameLayout
            android:id="@+id/screenBottomAds"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <include layout="@layout/include_screen_bottom_ads" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
