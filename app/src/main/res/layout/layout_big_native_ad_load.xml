<?xml version="1.0" encoding="utf-8"?>
<!-- Shimmer placeholder matching admob_big_native_ad: media on top (180dp), then icon +
     headline + 2-line body, then full-width CTA. Keep the sizes in sync with that layout. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_native_ad_card"
    android:tag="native_shimmer_root"
    android:orientation="vertical"
    android:padding="@dimen/_8sdp">

    <View
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="@drawable/bg_shimmer_placeholder" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8sdp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:background="@drawable/bg_shimmer_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_8sdp"
            android:layout_weight="1"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/_12sdp"
                android:background="@drawable/bg_shimmer_placeholder" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_4sdp"
                android:background="@drawable/bg_shimmer_placeholder" />

            <View
                android:layout_width="@dimen/_140sdp"
                android:layout_height="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_3sdp"
                android:background="@drawable/bg_shimmer_placeholder" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/_40sdp"
        android:layout_marginTop="@dimen/_8sdp"
        android:background="@drawable/bg_shimmer_placeholder" />
</LinearLayout>
