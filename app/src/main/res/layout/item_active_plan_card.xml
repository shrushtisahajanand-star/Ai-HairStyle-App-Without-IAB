<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/_10sdp"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="@dimen/_12sdp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:background="@drawable/bg_nav_home_fab">

            <ImageView
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_upgrade_icon" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/saans_medium"
                android:includeFontPadding="false"
                android:letterSpacing="0.04"
                android:text="@string/current_plan_label"
                android:textAllCaps="true"
                android:textColor="@color/nav_inactive"
                android:textSize="@dimen/_10ssp" />

            <TextView
                android:id="@+id/tvPlanName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4sdp"
                android:fontFamily="@font/saans_semibold"
                android:includeFontPadding="false"
                android:textColor="@color/white"
                android:textSize="@dimen/_13ssp"
                tools:text="Monthly Plan" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_plan_active_badge"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/_10sdp"
            android:paddingVertical="@dimen/_5sdp">

            <View
                android:layout_width="@dimen/_6sdp"
                android:layout_height="@dimen/_6sdp"
                android:background="@drawable/bg_plan_active_dot" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_6sdp"
                android:fontFamily="@font/saans_semibold"
                android:includeFontPadding="false"
                android:text="@string/plan_active_badge"
                android:textColor="@color/plan_active_green"
                android:textSize="@dimen/_11ssp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/_12sdp"
        android:layout_marginBottom="@dimen/_4sdp"
        android:background="@drawable/bg_settings_divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="@dimen/_7sdp">

        <ImageView
            android:layout_width="@dimen/_15sdp"
            android:layout_height="@dimen/_15sdp"
            android:contentDescription="@null"
            android:src="@drawable/ic_plan_calendar" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_8sdp"
            android:layout_weight="1"
            android:fontFamily="@font/saans_regular"
            android:includeFontPadding="false"
            android:text="@string/plan_started_on"
            android:textColor="@color/nav_inactive"
            android:textSize="@dimen/_12ssp" />

        <TextView
            android:id="@+id/tvStartedOn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/saans_medium"
            android:includeFontPadding="false"
            android:textColor="@color/white"
            android:textSize="@dimen/_12ssp"
            tools:text="20 July 2026" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="@dimen/_7sdp">

        <ImageView
            android:layout_width="@dimen/_15sdp"
            android:layout_height="@dimen/_15sdp"
            android:contentDescription="@null"
            android:src="@drawable/ic_plan_clock" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_8sdp"
            android:layout_weight="1"
            android:fontFamily="@font/saans_regular"
            android:includeFontPadding="false"
            android:text="@string/plan_expires_on"
            android:textColor="@color/nav_inactive"
            android:textSize="@dimen/_12ssp" />

        <TextView
            android:id="@+id/tvExpiresOn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/saans_medium"
            android:includeFontPadding="false"
            android:textColor="@color/white"
            android:textSize="@dimen/_12ssp"
            tools:text="20 August 2026" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="@dimen/_7sdp">

        <ImageView
            android:layout_width="@dimen/_15sdp"
            android:layout_height="@dimen/_15sdp"
            android:contentDescription="@null"
            android:src="@drawable/ic_plan_remaining" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_8sdp"
            android:layout_weight="1"
            android:fontFamily="@font/saans_regular"
            android:includeFontPadding="false"
            android:text="@string/plan_remaining"
            android:textColor="@color/nav_inactive"
            android:textSize="@dimen/_12ssp" />

        <TextView
            android:id="@+id/tvRemaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/saans_medium"
            android:includeFontPadding="false"
            android:textColor="@color/white"
            android:textSize="@dimen/_12ssp"
            tools:text="31 Days" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="@dimen/_7sdp">

        <ImageView
            android:layout_width="@dimen/_15sdp"
            android:layout_height="@dimen/_15sdp"
            android:contentDescription="@null"
            android:src="@drawable/ic_plan_status" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_8sdp"
            android:layout_weight="1"
            android:fontFamily="@font/saans_regular"
            android:includeFontPadding="false"
            android:text="@string/plan_status"
            android:textColor="@color/nav_inactive"
            android:textSize="@dimen/_12ssp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/saans_medium"
            android:includeFontPadding="false"
            android:text="@string/plan_active_badge"
            android:textColor="@color/plan_active_green"
            android:textSize="@dimen/_12ssp" />
    </LinearLayout>
</LinearLayout>
