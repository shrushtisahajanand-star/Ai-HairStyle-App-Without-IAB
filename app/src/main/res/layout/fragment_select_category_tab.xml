<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvHairstyles"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/_6sdp"
        android:paddingBottom="@dimen/_12sdp"
        android:visibility="gone"
        tools:listitem="@layout/item_category_hairstyle" />

    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmerHairstyles"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible"
        app:shimmer_auto_start="true"
        app:shimmer_base_alpha="0.55"
        app:shimmer_duration="1100"
        app:shimmer_highlight_alpha="1"
        app:shimmer_intensity="0.3"
        tools:visibility="visible">

        <include layout="@layout/layout_shimmer_category_grid" />
    </com.facebook.shimmer.ShimmerFrameLayout>

</FrameLayout>
