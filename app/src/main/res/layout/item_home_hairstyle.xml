<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/_110sdp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingEnd="@dimen/_10sdp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="@dimen/_130sdp"
        android:background="#00000000"
        app:cardBackgroundColor="@color/photo_select_icon_background"
        app:cardCornerRadius="@dimen/_15sdp"
        app:cardElevation="0dp"
        app:strokeColor="#00000000"
        app:strokeWidth="0dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/ivHairstyle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmerHairstyle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:shimmer_auto_start="true"
                app:shimmer_base_alpha="0.25"
                app:shimmer_duration="1100"
                app:shimmer_highlight_alpha="1"
                app:shimmer_intensity="0.6">
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_shimmer_placeholder" />
            </com.facebook.shimmer.ShimmerFrameLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_home_category_overlay" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginHorizontal="@dimen/_5sdp"
                android:ellipsize="end"
                android:fontFamily="@font/saans_regular"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:paddingHorizontal="@dimen/_6sdp"
                android:paddingTop="@dimen/_24sdp"
                android:paddingBottom="@dimen/_10sdp"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:textColor="@color/white"
                android:textSize="@dimen/_11ssp"
                tools:text="Afro" />

            <ImageView
                android:id="@+id/ivLock"
                android:layout_width="@dimen/_22sdp"
                android:layout_height="@dimen/_22sdp"
                android:layout_gravity="top|end"
                android:layout_margin="@dimen/_6sdp"
                android:background="@drawable/bg_lock_badge"
                android:contentDescription="@null"
                android:padding="@dimen/_5sdp"
                android:src="@drawable/ic_lock_badge"
                android:visibility="gone"
                tools:visibility="visible" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
