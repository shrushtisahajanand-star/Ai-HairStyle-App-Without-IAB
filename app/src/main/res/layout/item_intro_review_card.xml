<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/_240sdp"
    android:layout_height="match_parent"
    android:layout_marginHorizontal="@dimen/_8sdp"
    android:background="@drawable/bg_upload_photo_button_orig"
    android:padding="@dimen/_2sdp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardBackgroundColor="@color/orig_nav_bar_background"
        app:cardCornerRadius="@dimen/_22sdp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"

            android:padding="@dimen/_14sdp">

            <LinearLayout
                android:id="@+id/header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/tvReviewTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/saans_semibold"
                    android:includeFontPadding="false"
                    android:layout_weight="1"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_11ssp"

                    tools:text="Perfect Hair Preview" />

                <TextView
                    android:id="@+id/tvReviewStars"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/saans_semibold"
                    android:includeFontPadding="false"
                    android:text="@string/intro_rating_stars"
                    android:textColor="@color/star_gold"
                    android:textSize="@dimen/_11ssp" />


            </LinearLayout>

            <TextView
                android:id="@+id/tvReviewBody"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/_10sdp"
                android:ellipsize="end"
                android:fontFamily="@font/saans_regular"
                android:includeFontPadding="false"
                android:lineSpacingExtra="@dimen/_2sdp"
                android:maxLines="5"
                android:textColor="@color/orig_nav_inactive"
                android:textSize="@dimen/_10ssp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/ivFlag"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/header"
                tools:text="The AI hairstyle results are amazing!" />

            <ImageView
                android:id="@+id/ivFlag"
                android:layout_width="@dimen/_16sdp"
                android:layout_height="@dimen/_16sdp"
                android:contentDescription="@null"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:src="@drawable/ic_flag1" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
