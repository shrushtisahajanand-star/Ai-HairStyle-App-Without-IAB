<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/_84sdp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingEnd="@dimen/_8sdp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardColor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/photo_select_icon_background"
        app:cardCornerRadius="@dimen/_12sdp"
        app:cardElevation="0dp"
        app:strokeColor="@color/white"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/_8sdp">

            <FrameLayout
                android:layout_width="@dimen/_46sdp"
                android:layout_height="@dimen/_46sdp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivColor"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Circle"
                    tools:src="@drawable/bg_badge_before" />

                <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/shimmerColor"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:shimmer_auto_start="true"
                    app:shimmer_base_alpha="0.55"
                    app:shimmer_duration="1100"
                    app:shimmer_highlight_alpha="1"
                    app:shimmer_intensity="0.3">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_shimmer_circle" />
                </com.facebook.shimmer.ShimmerFrameLayout>
                <ImageView
                    android:id="@+id/ivLock"
                    android:layout_width="@dimen/_16sdp"
                    android:layout_height="@dimen/_16sdp"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="@dimen/_2sdp"
                    android:background="@drawable/bg_lock_badge"
                    android:contentDescription="@null"
                    android:padding="@dimen/_4sdp"
                    android:src="@drawable/ic_lock_badge"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvColorName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:ellipsize="end"
                android:fontFamily="@font/saans_medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/white"
                android:textSize="@dimen/_11ssp"
                tools:text="Black" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
