<?xml version="1.0" encoding="utf-8"?>

<resources>

    <style name="ShapeAppearance.Circle" parent="">

        <item name="cornerFamily">rounded</item>

        <item name="cornerSize">50%</item>

    </style>

    <style name="ShapeAppearance.Rounded14" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/_14sdp</item>
    </style>



    <style name="Widget.App.FunTabLayout" parent="Widget.Material3.TabLayout">
        <item name="android:background">@android:color/transparent</item>
        <item name="tabBackground">@null</item>
        <item name="tabGravity">fill</item>
        <item name="tabIndicator">@drawable/bg_fun_tab_selected_inset</item>
        <item name="tabIndicatorColor">@android:color/transparent</item>
        <item name="tabIndicatorFullWidth">true</item>
        <item name="tabIndicatorGravity">center</item>
        <item name="tabIndicatorHeight">@dimen/_32sdp</item>
        <item name="tabMode">fixed</item>
        <item name="tabPaddingEnd">@dimen/_2sdp</item>
        <item name="tabPaddingStart">@dimen/_2sdp</item>
        <item name="tabRippleColor">@android:color/transparent</item>
        <item name="tabSelectedTextColor">@color/white</item>
<!--        <item name="tabTextAlignment">center</item>-->
        <item name="tabTextColor">@color/white</item>
        <item name="tabTextAppearance">@style/TextAppearance.App.FunTab</item>
    </style>



    <style name="TextAppearance.App.FunTab" parent="TextAppearance.Material3.LabelLarge">

        <item name="android:textSize">@dimen/_12sdp</item>

        <item name="android:fontFamily">@font/saans_medium</item>

        <item name="android:gravity">center</item>

        <item name="android:includeFontPadding">false</item>

        <item name="android:textAllCaps">false</item>

    </style>

    <style name="NativeAdsView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:visibility">gone</item>
    </style>

</resources>

