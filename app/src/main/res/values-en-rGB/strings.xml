    <string name="intro_review_1_title">Perfect Hair Preview</string>
    <string name="intro_review_1_body">The AI hairstyle results are amazing! I could try different haircuts in seconds and the changes looked very natural. This app made choosing my next hairstyle so easy.</string>
    <string name="intro_review_2_title">Natural AI Results</string>
    <string name="intro_review_2_body">The styles look realistic and the app is easy to use. I tried multiple looks before choosing my favourite one.</string>
    <string name="intro_review_3_title">Great Style Options</string>
    <string name="intro_review_3_body">So many hairstyle options to explore. The preview helped me decide quickly without visiting a salon first.</string>
    <string name="intro_review_4_title">Easy and Fast</string>
    <string name="intro_review_4_body">Upload, pick a style, and get results in seconds. Exactly what I needed before changing my look.</string>
