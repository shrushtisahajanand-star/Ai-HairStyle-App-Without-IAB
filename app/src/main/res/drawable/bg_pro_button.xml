<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/pro_button_background" />
            <corners android:radius="@dimen/_14sdp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.82"
                android:centerY="0.5"
                android:endColor="@color/pro_button_glow_end"
                android:gradientRadius="80%p"
                android:startColor="@color/pro_button_glow_start"
                android:type="radial" />
            <corners android:radius="@dimen/_14sdp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="0.5dp"
                android:color="@color/pro_button_stroke" />
            <corners android:radius="@dimen/_14sdp" />
        </shape>
    </item>
</layer-list>
