<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- Gradient Border -->
  <item>
    <shape android:shape="rectangle">
      <corners android:radius="100dp"/>

      <gradient
          android:angle="0"
          android:startColor="#D9D9D9"
          android:centerColor="#6E6E6E"
          android:endColor="#111111"/>
    </shape>
  </item>

  <!-- White Background -->
  <item
      android:left="2dp"
      android:top="2dp"
      android:right="2dp"
      android:bottom="2dp">

    <shape android:shape="rectangle">
      <corners android:radius="98dp"/>
      <solid android:color="#FFFFFF"/>
    </shape>

  </item>

</layer-list>