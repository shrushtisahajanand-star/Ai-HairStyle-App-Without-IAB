    <fragment
        android:id="@+id/homePageFragment"
        android:name="com.hairstyle.generator.aimakerover.ui.home.HomePageFragment"
        android:label="Home Page">
        <action
            android:id="@+id/action_homePage_to_selectPhoto"
            app:destination="@id/photoSelectFragment" />
        <action
            android:id="@+id/action_homePage_to_setting"
            app:destination="@id/settingFragment" />
        <action
            android:id="@+id/action_homePage_to_selectCategory"
            app:destination="@id/selectCategoryFragment" />
        <action
            android:id="@+id/action_homePage_to_premium"
            app:destination="@id/premiumFragment" />
    </fragment>

    <fragment
        android:id="@+id/selectCategoryFragment"
        android:name="com.hairstyle.generator.aimakerover.ui.category.SelectCategoryFragment"
        android:label="@string/select_hairstyle">
        <argument
            android:name="initial_tab"
            android:defaultValue="0"
            app:argType="integer" />
        <!-- true when user already picked a photo (Upload Your Photo flow). -->
        <argument
            android:name="photo_already_selected"
            android:defaultValue="false"
            app:argType="boolean" />
        <action
            android:id="@+id/action_selectCategory_to_photoSelect"
            app:destination="@id/photoSelectFragment" />
        <action
            android:id="@+id/action_selectCategory_to_progress"
            app:destination="@id/progressFragment" />
    </fragment>

    <fragment
        android:id="@+id/settingFragment"
        android:name="com.hairstyle.generator.aimakerover.ui.setting.SettingFragment"
        android:label="@string/setting_title">
        <action
            android:id="@+id/action_setting_to_userCreation"
            app:destination="@id/userCreationFragment" />
        <action
            android:id="@+id/action_setting_to_premium"
            app:destination="@id/premiumFragment" />
        <action
            android:id="@+id/action_setting_to_activeSubscription"
            app:destination="@id/activeSubscriptionFragment" />
        <action
            android:id="@+id/action_setting_to_language"
            app:destination="@id/languageFragment" />
        <action
            android:id="@+id/action_setting_to_feedback"
            app:destination="@id/feedbackFragment" />
    </fragment>

    <fragment
        android:id="@+id/feedbackFragment"
        android:name="com.hairstyle.generator.aimakerover.ui.feedback.FeedbackFragment"
        android:label="@string/feedback" />

    <fragment
        android:id="@+id/activeSubscriptionFragment"
        android:name="com.hairstyle.generator.aimakerover.ui.setting.ActiveSubscriptionFragment"
        android:label="@string/current_plan">
        <action
            android:id="@+id/action_activeSubscription_to_premium"
            app:destination="@id/premiumFragment" />
    </fragment>

    <fragment
        android:id="@+id/languageFragment"
        android:name="com.hairstyle.generator.aimakerover.ui.language.LanguageFragment"
        android:label="@string/choose_language">
        <argument
            android:name="from_settings"
            android:defaultValue="false"
            app:argType="boolean" />
        <action
            android:id="@+id/action_language_to_intro1"
            app:destination="@id/intro1Fragment" />
        <action
            android:id="@+id/action_language_to_home"
            app:destination="@id/homePageFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/intro1Fragment"
        android:name="com.hairstyle.generator.aimakerover.ui.intro.Intro1Fragment"
        android:label="@string/get_started">
        <action
            android:id="@+id/action_intro1_to_intro1b"
            app:destination="@id/intro1bFragment" />
    </fragment>

    <fragment
        android:id="@+id/intro1bFragment"
        android:name="com.hairstyle.generator.aimakerover.ui.intro.Intro1bFragment"
        android:label="@string/intro1_page2_title">
        <action
            android:id="@+id/action_intro1b_to_intro1c"
            app:destination="@id/intro1cFragment" />
    </fragment>

    <fragment
        android:id="@+id/intro1cFragment"
        android:name="com.hairstyle.generator.aimakerover.ui.intro.Intro1cFragment"
        android:label="@string/intro1_page3_title">
        <action
            android:id="@+id/action_intro1c_to_intro1d"
            app:destination="@id/intro1dFragment" />
    </fragment>

    <fragment
        android:id="@+id/intro1dFragment"
        android:name="com.hairstyle.generator.aimakerover.ui.intro.Intro1dFragment"
        android:label="@string/intro1_page4_title">
        <action
            android:id="@+id/action_intro1d_to_intro2"
            app:destination="@id/intro2Fragment" />
    </fragment>

    <fragment
        android:id="@+id/intro2Fragment"
        android:name="com.hairstyle.generator.aimakerover.ui.intro.Intro2Fragment"
        android:label="@string/intro2_title">
        <action
            android:id="@+id/action_intro2_to_intro3"
            app:destination="@id/intro3Fragment" />
    </fragment>

    <fragment
        android:id="@+id/intro3Fragment"
        android:name="com.hairstyle.generator.aimakerover.ui.intro.Intro3Fragment"
        android:label="@string/intro3_title">
        <action
            android:id="@+id/action_intro3_to_premium"
            app:destination="@id/premiumFragment" />
        <action
            android:id="@+id/action_intro3_to_home"
            app:destination="@id/homePageFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/premiumFragment"
        android:name="com.hairstyle.generator.aimakerover.ui.premium.PremiumFragment"
        android:label="@string/upgrade_to_premium">
        <argument
            android:name="from_intro"
            android:defaultValue="false"
            app:argType="boolean" />
        <action
            android:id="@+id/action_premium_to_home"
            app:destination="@id/homePageFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/userCreationFragment"
        android:name="com.hairstyle.generator.aimakerover.ui.creation.UserCreationFragment"
        android:label="@string/user_creations">
        <action
            android:id="@+id/action_userCreation_to_preview"
            app:destination="@id/userCreationPreviewFragment" />
    </fragment>

    <fragment
        android:id="@+id/userCreationPreviewFragment"
        android:name="com.hairstyle.generator.aimakerover.ui.creation.UserCreationPreviewFragment"
        android:label="@string/user_creations">
        <argument
            android:name="creation_id"
            app:argType="string" />
        <action
            android:id="@+id/action_userCreationPreview_to_premium"
            app:destination="@id/premiumFragment" />
    </fragment>

    <fragment
        android:id="@+id/photoSelectFragment"
        android:name="com.hairstyle.generator.aimakerover.ui.gallery.PhotoSelectFragment"
        android:label="@string/photo_select_title">
        <!-- Upload Your Photo: pick photo first, then Select Category. -->
        <argument
            android:name="photo_first_flow"
            android:defaultValue="false"
            app:argType="boolean" />
        <action
            android:id="@+id/action_photoSelect_to_progress"
            app:destination="@id/progressFragment" />
        <action
            android:id="@+id/action_photoSelect_to_selectCategory"
            app:destination="@id/selectCategoryFragment" />
        <action
            android:id="@+id/action_photoSelect_to_galleryPhotoSelection"
            app:destination="@id/galleryPhotoSelectionFragment" />
        <action
            android:id="@+id/action_photoSelect_to_premium"
            app:destination="@id/premiumFragment" />
        <action
            android:id="@+id/action_photoSelect_to_home"
            app:destination="@id/homePageFragment"
            app:popUpTo="@id/homePageFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/galleryPhotoSelectionFragment"
        android:name="com.hairstyle.generator.aimakerover.ui.gallery.GalleryPhotoSelectionFragment"
        android:label="@string/gallery_photo_selection_title">
        <argument
            android:name="photo_first_flow"
            android:defaultValue="false"
            app:argType="boolean" />
        <action
            android:id="@+id/action_galleryPhotoSelection_to_progress"
            app:destination="@id/progressFragment" />
        <action
            android:id="@+id/action_galleryPhotoSelection_to_selectCategory"
            app:destination="@id/selectCategoryFragment" />
        <action
            android:id="@+id/action_galleryPhotoSelection_to_premium"
            app:destination="@id/premiumFragment" />
        <action
            android:id="@+id/action_galleryPhotoSelection_to_home"
            app:destination="@id/homePageFragment"
            app:popUpTo="@id/homePageFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/progressFragment"
        android:name="com.hairstyle.generator.aimakerover.ui.progress.ProgressFragment"
        android:label="@string/preparing_your_photo">
        <action
            android:id="@+id/action_progress_to_result"
            app:destination="@id/resultFragment"
            app:popUpTo="@id/photoSelectFragment"
            app:popUpToInclusive="false" />
        <action
            android:id="@+id/action_progress_to_premium"
            app:destination="@id/premiumFragment" />
        <action
            android:id="@+id/action_progress_to_home"
            app:destination="@id/homePageFragment"
            app:popUpTo="@id/homePageFragment"
            app:popUpToInclusive="true" />
    </fragment>

