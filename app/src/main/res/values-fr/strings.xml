    <string name="intro_review_1_title">Aperçu parfait des cheveux</string>
    <string name="intro_review_1_body">Les résultats des coiffures par IA sont incroyables ! J\'ai pu essayer différentes coupes en quelques secondes et les changements semblaient très naturels. Cette application a rendu le choix de ma prochaine coiffure si facile.</string>
    <string name="intro_review_2_title">Résultats IA naturels</string>
    <string name="intro_review_2_body">Les styles sont réalistes et l\'application est facile à utiliser. J\'ai essayé plusieurs looks avant de choisir mon favori.</string>
    <string name="intro_review_3_title">Excellentes options de style</string>
    <string name="intro_review_3_body">Tant d\'options de coiffures à explorer. L\'aperçu m\'a aidé à décider rapidement sans visiter un salon au préalable.</string>
    <string name="intro_review_4_title">Facile et rapide</string>
    <string name="intro_review_4_body">Téléchargez, choisissez un style et obtenez des résultats en quelques secondes. Exactement ce dont j\'avais besoin avant de changer mon look.</string>
